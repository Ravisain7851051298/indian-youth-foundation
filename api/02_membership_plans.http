### ==============================================================================
### DYNAMIC MEMBERSHIP PLANS APIS (Zero-Fraud Custom Plans)
### ==============================================================================

@baseUrl = http://localhost:5000/api
@adminSecretKey = BYK_SUPER_ADMIN_ALIGARH_SECRET_2026
@adminToken = REPLACE_WITH_ADMIN_BEARER_TOKEN

### 1. Get All Public Membership Plans
GET {{baseUrl}}/plans

### 2. Create Custom Membership Plan (Admin Only)
POST {{baseUrl}}/plans
Authorization: Bearer {{adminToken}}
x-admin-secret-key: {{adminSecretKey}}
Content-Type: application/json

{
  "title": "Rashtriya Seva Ratna (Patron)",
  "titleHi": "राष्ट्रीय सेवा रत्न (संरक्षक सदस्यता)",
  "price": 1100,
  "validityMonths": 24,
  "benefits": [
    "Dual-Sided Executive ID Card with QR Verification",
    "Formal Sealed Appointment Letter by National President",
    "VIP Access to Annual Youth Conclave",
    "Eligible for State Coordinator Recommendation"
  ],
  "benefitsHi": [
    "क्यूआर कोड युक्त दोतरफा कार्यकारी पहचान पत्र",
    "राष्ट्रीय अध्यक्ष द्वारा हस्ताक्षरित आधिकारिक नियुक्ति पत्र",
    "वार्षिक युवा सम्मेलन में वीआईपी आमंत्रण",
    "राज्य समन्वय समिति में नामांकन का अवसर"
  ],
  "isPopular": true
}

### 3. Update Existing Plan (Admin Only)
PUT {{baseUrl}}/plans/PLAN_ID_HERE
Authorization: Bearer {{adminToken}}
x-admin-secret-key: {{adminSecretKey}}
Content-Type: application/json

{
  "price": 1200,
  "isPopular": true
}

### 4. Delete Plan (Admin Only)
DELETE {{baseUrl}}/plans/PLAN_ID_HERE
Authorization: Bearer {{adminToken}}
x-admin-secret-key: {{adminSecretKey}}
